generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================
// AUTH
// ============================================================

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             String    @default("user")     // user | admin
  plan             String    @default("free")     // free | premium
  planExpiresAt    DateTime?
  activeBusinessId String?                        // current business for all modules
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  businesses     Business[]
  submissions    Submission[]
  videos         Video[]
  socialAccounts SocialAccount[]
  qaPosts        QAPost[]
  payments       Payment[]
  passwordResetTokens PasswordResetToken[]
  affiliateAccounts UserAffiliateAccount[]
  moneyEnginePosts  MoneyEnginePost[]
  moneyEngineClicks MoneyEngineClick[]
  moneyEngineSales  MoneyEngineSale[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// BUSINESS (every module targets the active business)
// ============================================================

model Business {
  id          String       @id @default(cuid())
  userId      String
  name        String
  website     String
  keywords    String
  description String
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]
  qaPosts     QAPost[]

  @@index([userId])
}

// ============================================================
// MODULE TRACKING
// ============================================================

model Submission {
  id           String    @id @default(cuid())
  userId       String
  businessId   String?
  type         String    // qa | classified | indexer | social | video
  platform     String
  url          String
  submittedUrl String
  status       String    @default("submitted")
  country      String?
  clicks       Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([createdAt])
}

model Video {
  id                String    @id @default(cuid())
  userId            String
  businessId        String?
  url               String
  thumbnail         String?
  platform          String    @default("tiktok")
  status            String    @default("pending")
  title             String?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  template          String    @default("product_promo")
  script            String?   @db.Text
  productImageUrl   String?   @db.Text
  priceText         String?
  ctaText           String?
  brandColor        String    @default("#4f46e5")
  error             String?   @db.Text
  filePath          String?
  fileSizeBytes     Int?
  durationSeconds   Int?
  renderStartedAt   DateTime?
  renderCompletedAt DateTime?

  @@index([userId])
}

model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String    // facebook | twitter
  accountId    String
  accountName  String?
  accessToken  String
  pages        String?   // JSON string (portable across SQLite/Postgres)
  dailyCount   Int       @default(0)
  lastPostDate DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, accountId])
}

// ============================================================
// Q&A CLONE (public Reddit/Lemmy-style feed with FAQ schema)
// ============================================================

model QAPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  userId         String
  businessId     String?
  title          String
  body           String
  sourceUrl      String
  sourcePlatform String
  status         String    @default("published")
  views          Int       @default(0)
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business       Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

// ============================================================
// BILLING (Flutterwave)
// ============================================================

model Payment {
  id        String    @id @default(cuid())
  userId    String
  reference String    @unique
  amount    Int
  currency  String    @default("NGN")
  status    String    @default("pending")   // pending | success | failed
  plan      String    @default("premium")
  channel   String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}
// ═══════════════════════════════════════════════════════════
// AUTO MONEY ENGINE — v2.0
// ═══════════════════════════════════════════════════════════

model UserAffiliateAccount {
  id                    String    @id @default(cuid())
  userId                String
  platform              String    // 'warriorplus','jvzoo','impact','partnerstack','temu','aliexpress','jumia','konga'
  affiliateUsername     String?
  affiliateId           String?
  apiKeyEncrypted       String?   @db.Text
  apiSecretEncrypted    String?   @db.Text
  accessTokenEncrypted  String?   @db.Text
  refreshTokenEncrypted String?   @db.Text
  accountId             String?
  isConnected           Boolean   @default(false)
  lastVerifiedAt        DateTime?
  createdAt             DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("user_affiliate_accounts")
}

model MoneyEngineOffer {
  id                  String    @id @default(cuid())
  productType         String    // 'digital' | 'physical'
  platform            String
  offerId             String
  title               String
  vendor              String?
  category            String?
  frontEndPrice       Decimal?  @db.Decimal(10, 2)
  originalPrice       Decimal?  @db.Decimal(10, 2)
  funnelMaxPrice      Decimal?  @db.Decimal(10, 2)
  commissionPct       Decimal?  @db.Decimal(5, 2)
  commissionAmount    Decimal?  @db.Decimal(10, 2)
  commissionType      String    @default("CPS")
  epc                 Decimal   @default(0) @db.Decimal(10, 2)
  conversionRate      Decimal   @default(0) @db.Decimal(5, 2)
  gravity             Decimal   @default(0) @db.Decimal(10, 2)
  refundRate          Decimal   @default(0) @db.Decimal(5, 2)
  orders7days         Int       @default(0)
  rating              Decimal   @default(0) @db.Decimal(3, 2)
  isRecurring         Boolean   @default(false)
  recurringMonths     Int       @default(0)
  salesPageUrl        String?   @db.Text
  imageUrl            String?   @db.Text
  videoUrl            String?   @db.Text
  affiliateLinkTemplate String? @db.Text
  swipeCopy           String?   @db.Text
  status              String    @default("active") // 'active' | 'paused' | 'dead'
  score               Decimal   @default(0) @db.Decimal(10, 2)
  priority            String    @default("normal") // 'low' | 'normal' | 'high'
  lastSyncedAt        DateTime  @default(now())
  createdAt           DateTime  @default(now())

  posts  MoneyEnginePost[]
  clicks MoneyEngineClick[]
  sales  MoneyEngineSale[]

  @@unique([platform, offerId])
  @@index([score(sort: Desc)])
  @@index([productType])
  @@map("money_engine_offers")
}

model MoneyEnginePost {
  id            String    @id @default(cuid())
  userId        String
  offerId       String
  productType   String
  trafficModule String    // 'tiktok' | 'facebook' | 'x' | 'youtube'
  caption       String?   @db.Text
  script        String?   @db.Text
  videoUrl      String?   @db.Text
  affiliateLink String    @db.Text
  cloakedLink   String?   @db.Text
  utmSource     String?
  status        String    @default("draft") // 'draft' | 'queued' | 'posted' | 'failed'
  postedAt      DateTime?
  clicks        Int       @default(0)
  sales         Int       @default(0)
  commission    Decimal   @default(0) @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer  MoneyEngineOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clicksRel MoneyEngineClick[]
  salesRel  MoneyEngineSale[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("money_engine_posts")
}

model MoneyEngineClick {
  id            String   @id @default(cuid())
  postId        String
  userId        String
  offerId       String
  trafficSource String?
  ipAddress     String?
  userAgent     String?  @db.Text
  clickedAt     DateTime @default(now())

  post  MoneyEnginePost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer MoneyEngineOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([offerId])
  @@map("money_engine_clicks")
}

model MoneyEngineSale {
  id               String   @id @default(cuid())
  userId           String
  offerId          String
  postId           String?
  platform         String
  transactionId    String?
  saleAmount       Decimal  @db.Decimal(10, 2)
  commissionAmount Decimal  @db.Decimal(10, 2)
  status           String   @default("pending")
  createdAt        DateTime @default(now())

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer MoneyEngineOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  post  MoneyEnginePost?  @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@map("money_engine_sales")
}