generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================
// AUTH
// ============================================================

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             String    @default("user")     // user | admin
  plan             String    @default("free")     // free | premium
  planExpiresAt    DateTime?
  activeBusinessId String?                        // current business for all modules
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  businesses     Business[]
  submissions    Submission[]
  videos         Video[]
  socialAccounts SocialAccount[]
  qaPosts        QAPost[]
  payments       Payment[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// BUSINESS (every module targets the active business)
// ============================================================

model Business {
  id          String       @id @default(cuid())
  userId      String
  name        String
  website     String
  keywords    String
  description String
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]
  qaPosts     QAPost[]

  @@index([userId])
}

// ============================================================
// MODULE TRACKING
// ============================================================

model Submission {
  id           String    @id @default(cuid())
  userId       String
  businessId   String?
  type         String    // qa | classified | indexer | social | video
  platform     String
  url          String
  submittedUrl String
  status       String    @default("submitted")
  country      String?
  clicks       Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([createdAt])
}

model Video {
  id         String   @id @default(cuid())
  userId     String
  businessId String?
  url        String
  thumbnail  String?
  platform   String
  status     String   @default("pending")
  title      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String    // facebook | twitter
  accountId    String
  accountName  String?
  accessToken  String
  pages        String?   // JSON string (portable across SQLite/Postgres)
  dailyCount   Int       @default(0)
  lastPostDate DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, accountId])
}

// ============================================================
// Q&A CLONE (public Reddit/Lemmy-style feed with FAQ schema)
// ============================================================

model QAPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  userId         String
  businessId     String?
  title          String
  body           String
  sourceUrl      String
  sourcePlatform String
  status         String    @default("published")
  views          Int       @default(0)
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business       Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

// ============================================================
// BILLING (Flutterwave)
// ============================================================

model Payment {
  id        String    @id @default(cuid())
  userId    String
  reference String    @unique
  amount    Int
  currency  String    @default("NGN")
  status    String    @default("pending")   // pending | success | failed
  plan      String    @default("premium")
  channel   String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}