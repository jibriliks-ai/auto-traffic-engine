generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================
// AUTH
// ============================================================

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             String    @default("user")
  plan             String    @default("free")
  planExpiresAt    DateTime?
  activeBusinessId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Core auth
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  // Business
  businesses  Business[]
  submissions Submission[]
  qaPosts     QAPost[]

  // Video + social accounts
  videos         Video[]
  socialAccounts SocialAccount[]

  // Billing
  payments Payment[]

  // Money Engine — legacy
  affiliateAccounts UserAffiliateAccount[]
  moneyEnginePosts  MoneyEnginePost[]
  moneyEngineClicks MoneyEngineClick[]
  moneyEngineSales  MoneyEngineSale[]

  // Link cloaker + Link-to-Video
  moneyEngineLinks      MoneyEngineLink[]
  moneyEngineLinkClicks MoneyEngineLinkClick[]
  linkToVideoJobs       LinkToVideoJob[]

  // Sales Copy
  salesCopy MoneyEngineSalesCopy[]
  usedHooks MoneyEngineUsedHook[]

  // IndexNow
  indexNowSubmissions IndexNowSubmission[]

  // Social Poster
  socialConnections SocialConnection[]
  socialPosts       SocialPost[]

  // User tracking links (paste-your-affiliate-link method)
  trackingLinks UserTrackingLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// BUSINESS
// ============================================================

model Business {
  id          String       @id @default(cuid())
  userId      String
  name        String
  website     String
  keywords    String
  description String
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]
  qaPosts     QAPost[]

  @@index([userId])
}

// ============================================================
// MODULE TRACKING
// ============================================================

model Submission {
  id           String    @id @default(cuid())
  userId       String
  businessId   String?
  type         String
  platform     String
  url          String
  submittedUrl String
  status       String    @default("submitted")
  country      String?
  clicks       Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([createdAt])
}

model Video {
  id         String   @id @default(cuid())
  userId     String
  businessId String?
  url        String
  thumbnail  String?
  platform   String   @default("tiktok")
  status     String   @default("pending")
  title      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  template          String    @default("ffmpeg_professional")
  script            String?   @db.Text
  productImageUrl   String?   @db.Text
  priceText         String?
  ctaText           String?
  brandColor        String    @default("#4f46e5")
  error             String?   @db.Text
  filePath          String?
  fileSizeBytes     Int?
  durationSeconds   Int?
  renderStartedAt   DateTime?
  renderCompletedAt DateTime?

  @@index([userId])
}

model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  accountId    String
  accountName  String?
  accessToken  String
  pages        String?
  dailyCount   Int       @default(0)
  lastPostDate DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, accountId])
}

// ============================================================
// Q&A CLONE
// ============================================================

model QAPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  userId         String
  businessId     String?
  title          String
  body           String
  sourceUrl      String
  sourcePlatform String
  status         String    @default("published")
  views          Int       @default(0)
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business       Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

// ============================================================
// BILLING
// ============================================================

model Payment {
  id        String    @id @default(cuid())
  userId    String
  reference String    @unique
  amount    Int
  currency  String    @default("NGN")
  status    String    @default("pending")
  plan      String    @default("premium")
  channel   String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// ═══════════════════════════════════════════════════════════
// AUTO MONEY ENGINE
// ═══════════════════════════════════════════════════════════

// LEGACY — kept for backwards compatibility but not used by the app.
model UserAffiliateAccount {
  id                    String    @id @default(cuid())
  userId                String
  platform              String
  affiliateUsername     String?
  affiliateId           String?
  apiKeyEncrypted       String?   @db.Text
  apiSecretEncrypted    String?   @db.Text
  accessTokenEncrypted  String?   @db.Text
  refreshTokenEncrypted String?   @db.Text
  accountId             String?
  isConnected           Boolean   @default(false)
  lastVerifiedAt        DateTime?
  createdAt             DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("user_affiliate_accounts")
}

model MoneyEngineOffer {
  id                    String   @id @default(cuid())
  productType           String
  platform              String
  offerId               String
  title                 String
  vendor                String?
  category              String?
  frontEndPrice         Decimal? @db.Decimal(10, 2)
  originalPrice         Decimal? @db.Decimal(10, 2)
  funnelMaxPrice        Decimal? @db.Decimal(10, 2)
  commissionPct         Decimal? @db.Decimal(5, 2)
  commissionAmount      Decimal? @db.Decimal(10, 2)
  commissionType        String   @default("CPS")
  epc                   Decimal  @default(0) @db.Decimal(10, 2)
  conversionRate        Decimal  @default(0) @db.Decimal(5, 2)
  gravity               Decimal  @default(0) @db.Decimal(10, 2)
  refundRate            Decimal  @default(0) @db.Decimal(5, 2)
  orders7days           Int      @default(0)
  rating                Decimal  @default(0) @db.Decimal(3, 2)
  isRecurring           Boolean  @default(false)
  recurringMonths       Int      @default(0)
  salesPageUrl          String?  @db.Text
  imageUrl              String?  @db.Text
  videoUrl              String?  @db.Text
  affiliateLinkTemplate String?  @db.Text
  swipeCopy             String?  @db.Text
  status                String   @default("active")
  score                 Decimal  @default(0) @db.Decimal(10, 2)
  priority              String   @default("normal")
  lastSyncedAt          DateTime @default(now())
  createdAt             DateTime @default(now())

  posts     MoneyEnginePost[]
  clicks    MoneyEngineClick[]
  sales     MoneyEngineSale[]
  salesCopy MoneyEngineSalesCopy[]

  @@unique([platform, offerId])
  @@index([score(sort: Desc)])
  @@index([productType])
  @@map("money_engine_offers")
}

model MoneyEnginePost {
  id            String    @id @default(cuid())
  userId        String
  offerId       String
  productType   String
  trafficModule String
  caption       String?   @db.Text
  script        String?   @db.Text
  videoUrl      String?   @db.Text
  affiliateLink String    @db.Text
  cloakedLink   String?   @db.Text
  utmSource     String?
  status        String    @default("draft")
  postedAt      DateTime?
  clicks        Int       @default(0)
  sales         Int       @default(0)
  commission    Decimal   @default(0) @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer     MoneyEngineOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clicksRel MoneyEngineClick[]
  salesRel  MoneyEngineSale[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("money_engine_posts")
}

model MoneyEngineClick {
  id            String   @id @default(cuid())
  postId        String
  userId        String
  offerId       String
  trafficSource String?
  ipAddress     String?
  userAgent     String?  @db.Text
  clickedAt     DateTime @default(now())

  post  MoneyEnginePost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer MoneyEngineOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([offerId])
  @@map("money_engine_clicks")
}

model MoneyEngineSale {
  id               String   @id @default(cuid())
  userId           String
  offerId          String
  postId           String?
  platform         String
  transactionId    String?
  saleAmount       Decimal  @db.Decimal(10, 2)
  commissionAmount Decimal  @db.Decimal(10, 2)
  status           String   @default("pending")
  createdAt        DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer MoneyEngineOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  post  MoneyEnginePost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@map("money_engine_sales")
}

// ═══════════════════════════════════════════════════════════
// LINK CLOAKER
// ═══════════════════════════════════════════════════════════

model MoneyEngineLink {
  id             String   @id @default(cuid())
  userId         String
  offerId        String?
  campaignId     String?
  contentId      String?
  slug           String   @unique
  shortUrl       String
  destinationUrl String   @db.Text
  qrCodeUrl      String?  @db.Text
  sourceType     String   @default("video")
  platform       String?
  clicks         Int      @default(0)
  conversions    Int      @default(0)
  earnings       Decimal  @default(0) @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicksRel MoneyEngineLinkClick[]

  @@index([userId])
  @@index([offerId])
  @@index([slug])
  @@map("money_engine_links")
}

model MoneyEngineLinkClick {
  id        String   @id @default(cuid())
  linkId    String
  userId    String
  ipAddress String?
  userAgent String?  @db.Text
  referrer  String?  @db.Text
  country   String?
  platform  String?
  clickedAt DateTime @default(now())

  link MoneyEngineLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@map("money_engine_link_clicks")
}

// ═══════════════════════════════════════════════════════════
// LINK TO VIDEO
// ═══════════════════════════════════════════════════════════

model LinkToVideoJob {
  id            String   @id @default(cuid())
  userId        String
  originalUrl   String   @db.Text
  store         String?
  productName   String?
  price         Decimal? @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  currency      String   @default("NGN")
  images        String?  @db.Text
  description   String?  @db.Text
  affiliateUrl  String?  @db.Text
  shortUrl      String?
  status        String   @default("scraping")
  errorMessage  String?  @db.Text
  videoUrl      String?  @db.Text
  posterUrl     String?  @db.Text
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("link_to_video_jobs")
}

// ═══════════════════════════════════════════════════════════
// SALES COPY
// ═══════════════════════════════════════════════════════════

model MoneyEngineSalesCopy {
  id               String    @id @default(cuid())
  userId           String
  offerId          String
  contentId        String?
  platform         String
  postType         String
  title            String
  body             String    @db.Text
  hookUsed         String?   @db.Text
  angleUsed        String?
  variationSeed    Int
  shortUrl         String
  lemmyPostId      String?
  answerQuestionId String?
  answerAnswerId   String?
  lemmyUrl         String?
  answerUrl        String?
  status           String    @default("draft")
  scheduledAt      DateTime?
  postedAt         DateTime?
  retryCount       Int       @default(0)
  lastError        String?   @db.Text
  views            Int       @default(0)
  upvotes          Int       @default(0)
  clicks           Int       @default(0)
  createdAt        DateTime  @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer MoneyEngineOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId, platform, variationSeed])
  @@index([userId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@map("money_engine_sales_copy")
}

model MoneyEngineUsedHook {
  id         String   @id @default(cuid())
  userId     String
  hookText   String   @db.Text
  usedCount  Int      @default(1)
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hookText])
  @@map("money_engine_used_hooks")
}

// ═══════════════════════════════════════════════════════════
// INDEXNOW
// ═══════════════════════════════════════════════════════════

model IndexNowSubmission {
  id          String   @id @default(cuid())
  userId      String?
  url         String   @unique
  host        String
  submittedAt DateTime @default(now())
  endpoints   String?  @db.Text

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([submittedAt])
  @@map("indexnow_submissions")
}

// ═══════════════════════════════════════════════════════════
// SOCIAL POSTER
// ═══════════════════════════════════════════════════════════

model SocialConnection {
  id             String    @id @default(cuid())
  userId         String
  platform       String
  accountName    String?
  credentials    String    @db.Text
  isConnected    Boolean   @default(false)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("social_connections")
}

model SocialPost {
  id             String    @id @default(cuid())
  userId         String
  offerId        String?
  platform       String
  caption        String    @db.Text
  imageUrl       String?   @db.Text
  imageBase64    String?   @db.Text
  status         String    @default("draft")
  postedAt       DateTime?
  platformPostId String?
  platformUrl    String?
  error          String?   @db.Text
  retryCount     Int       @default(0)
  clicks         Int       @default(0)
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, postedAt])
  @@map("social_posts")
}

// ═══════════════════════════════════════════════════════════
// USER TRACKING LINKS — paste-affiliate-link method
// ═══════════════════════════════════════════════════════════

model UserTrackingLink {
  id              String   @id @default(cuid())
  userId          String
  platform        String // "impact" | "warriorplus"
  label           String
  productName     String
  productImageUrl String?  @db.Text
  merchantUrl     String   @db.Text
  trackingUrl     String   @db.Text
  price           Decimal? @db.Decimal(10, 2)
  originalPrice   Decimal? @db.Decimal(10, 2)
  currency        String   @default("USD")
  category        String?
  description     String?  @db.Text
  offerId         String?
  isActive        Boolean  @default(true)

  // Cloaked redirect (real affiliate URL never exposed)
  slug     String? @unique
  shortUrl String? @db.Text

  // Auto-scraped data
  scrapedTitle       String? @db.Text
  scrapedImage       String? @db.Text
  scrapedPrice       String?
  scrapedDescription String? @db.Text
  scrapedBrand       String?
  scrapeStatus       String  @default("pending") // pending | success | failed
  scrapeError        String? @db.Text

  // Auto-generated marketing content
  generatedImage    String?   @db.Text
  generatedSnippets String?   @db.Text
  generatedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
  @@index([userId, isActive])
  @@index([slug])
  @@map("user_tracking_links")
}
