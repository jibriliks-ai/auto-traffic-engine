# ============================================================
# AUTO TRAFFIC ENGINE — Environment Variables
# Copy to .env for local dev, or paste into Render → Environment.
# ============================================================

# ---------- APP ----------
NEXT_PUBLIC_APP_NAME="Auto Traffic Engine"
# Set to "true" to show "Continue with Google" on auth pages
# (requires GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET below)
NEXT_PUBLIC_GOOGLE_ENABLED=false

# ---------- REQUIRED ----------
# PostgreSQL — Render: create a PostgreSQL instance → copy the External URL
# Local dev alternatives:
#   Postgres:  postgresql://postgres:password@localhost:5432/auto_traffic
#   SQLite:    file:./dev.db  (also change provider to "sqlite" in schema.prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/auto_traffic

# Generate with PowerShell:
#   [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
NEXTAUTH_SECRET=7cacc1e9d797462aafe5437d4b84968325157eaf4efd4b3b8fc88c80d729afab
NEXTAUTH_URL=http://localhost:3000

# ---------- AI (pick one; both supported) ----------
# OpenAI: https://platform.openai.com
# DeepSeek: https://platform.deepseek.com
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---------- INDEXNOW (Module 4: Website Indexer) ----------
# Any 8–64 hex key. PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# The key file is served automatically at https://your-app/{KEY}.txt
INDEXNOW_KEY=3202602e5f823de268c4f4874fc081ac

# ---------- GOOGLE INDEXING API (optional) ----------
# Service-account JSON in ONE line (Indexing API must be enabled in Google Cloud)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- VIDEO MICROSERVICE (Module 5) ----------
VIDEO_SERVICE_URL=https://auto-traffic-video.onrender.com
VIDEO_SERVICE_TOKEN=change-me-long-random-string
ELEVENLABS_API_KEY=
UPLOADTHING_TOKEN=
BACKGROUND_MUSIC_URL=

# ---------- SOCIAL POSTING (Module 6) ----------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ---------- LOGIN PROVIDERS (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- BILLING (Flutterwave) ----------
FLUTTERWAVE_SECRET_KEY= FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_HASH= ate-webhook-secret-198005 
FLUTTERWAVE_PREMIUM_AMOUNT=25000 

# ---------- OPTIONAL ----------
LEADS_WEBHOOK_URL=
PAGESPEED_API_KEY=

# ---------- PWA ----------
# Icons served from /public/icons/. Minimum 192x192 for Android, 180x180 for iOS.
# Re-generate at https://realfavicongenerator.net/ if you change the logo.
CRON_SECRET=generate-a-long-random-string

# Auto sign-out after 20 min inactivity (hardcoded in hook, no env needed)
# Optional: keep users logged in for full 24h even if idle (set to "true" to skip idle timeout)
DISABLE_IDLE_TIMEOUT=false

# ---------- ADMIN ----------
# Comma-separated list of admin emails.
# Anyone with one of these emails is treated as admin (overrides DB role).
# No SQL needed — just add the email here and redeploy.
# Example: ADMIN_EMAILS=you@example.com,teammate@example.com
ADMIN_EMAILS=

# ---------- EMAIL (Resend — password reset) ----------
# Free tier: 3,000 emails/month, 100/day. No credit card.
# Get key: https://resend.com → sign up → API Keys → Create
RESEND_API_KEY=
# Verified sender address. Use onboarding@resend.dev for testing without domain.
# For production: verify your domain at resend.com/domains, then use
# RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev
# ─── AUTO MONEY ENGINE ───

# AES-256-GCM key (64 hex chars = 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# WarriorPlus
WARRIORPLUS_API_KEY=

# JVZoo
JVZOO_API_KEY=
JVZOO_SECRET=

# Impact.com (also used for Jumia + Konga)
IMPACT_SID=
IMPACT_TOKEN=
IMPACT_ACCOUNT_ID=

# PartnerStack
PARTNERSTACK_PUBLIC_KEY=
PARTNERSTACK_SECRET_KEY=

# Temu Affiliate (official API only — do not scrape)
TEMU_AFFILIATE_KEY=
TEMU_AFFILIATE_SECRET=

# AliExpress Portals (official API only — do not scrape)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Cron secret — protects /api/money-engine/cron
CRON_SECRET=