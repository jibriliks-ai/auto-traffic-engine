generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           String         @default("user")
  plan           String         @default("free")
  planExpiresAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  accounts       Account[]
  sessions       Session[]
  businesses     Business[]
  submissions    Submission[]
  videos         Video[]
  socialAccounts SocialAccount[]
  payments      Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Business {
  id          String       @id @default(cuid())
  userId      String
  name        String
  website     String
  keywords    String
  description String
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([userId])
}

model Submission {
  id           String    @id @default(cuid())
  userId       String
  businessId   String?
  type         String
  platform     String
  url          String
  submittedUrl String
  status       String    @default("submitted")
  country      String?
  clicks       Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([createdAt])
}

model Video {
  id         String   @id @default(cuid())
  userId     String
  businessId String?
  url        String
  thumbnail  String?
  platform   String
  status     String   @default("pending")
  title      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  accountId    String
  accountName  String?
  accessToken  String
  pages        String?
  dailyCount   Int       @default(0)
  lastPostDate DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, accountId])
}
model Payment {
  id        String    @id @default(cuid())
  userId    String
  reference String    @unique
  amount    Int
  currency  String    @default("NGN")
  status    String    @default("pending")
  plan      String    @default("premium")
  channel   String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}